{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix portal-server",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/portal/(login|home|clients|cases|archived|tasks|dashboard|admin)", "destination": "/api" }
  ]
}
