PORT=3000
NODE_ENV=production
SESSION_SECRET=change-this-in-production
# Local JSON file (no Postgres): NODE_ENV=development, omit DATABASE_URL, then npm start.
# Site + portal API: http://localhost:3000  (login: /portal/login.html)
SESSION_DAYS=7
SESSION_REMEMBER_DAYS=30
# Set true only if the API is on a different domain without /api proxy (cookies need SameSite=None):
# CROSS_ORIGIN_COOKIES=true

# Web push (generate keys: cd portal-server && npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gzlawfirm.net
TASK_REMINDER_MINUTES=45
TASK_DATE_ONLY_REMINDER_HOUR=6
PORTAL_TIMEZONE=Africa/Cairo

PUBLIC_BASE_URL=https://www.gzlawfirm.net
# Only these origins (plus preview subdomains of a listed *.pages.dev project) may call the API with cookies.
ALLOWED_ORIGINS=https://www.gzlawfirm.net,https://gzlawfirm.net,https://elgayarzeinlawfirm.pages.dev

# Cloudflare Pages talks to Railway directly (portal/api-config.js).
# Railway needs CROSS_ORIGIN_COOKIES=true plus ALLOWED_ORIGINS for the site hosts.
# To force same-origin /api again: PORTAL_USE_DIRECT_API=false on the Pages build.

ADMIN_USERNAME=محمود الجيار
# Required on Railway/production before first deploy (server refuses to seed admin without it).
ADMIN_PASSWORD=
ADMIN_NAME=محمود الجيار

# Local switch: local | railway
#   npm run local     → JSON file (portal-server/data/portal.json)
#   npm run railway   → Railway Postgres (uses DATABASE_PUBLIC_URL on this PC)
# On Railway hosts this is ignored; production always uses Postgres.
PORTAL_DB=local

# Railway API service: keep DATABASE_URL=${{Postgres.DATABASE_URL}} (private, no egress).
# Local only: paste DATABASE_PUBLIC_URL. Do not set that public URL on the Railway API service.
DATABASE_URL=
DATABASE_PUBLIC_URL=

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=gz-portal-attachments
